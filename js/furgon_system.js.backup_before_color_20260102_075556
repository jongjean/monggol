// 푸르공 3D 시스템
console.log('📄 furgon_system.js 로드');

let furgonModel = null;

function loadFurgon3D() {
    console.log('🚐 푸르공 3D 모델 로딩 시작...');
    
    // GLTFLoader 확인
    if (!window.GLTFLoader && !THREE.GLTFLoader) {
        console.error('❌ GLTFLoader가 없습니다! 폴백 박스 생성');
        createFallbackFurgon();
        return;
    }
    
    const LoaderClass = window.GLTFLoader || THREE.GLTFLoader;
    const loader = new LoaderClass();
    
    loader.load(
        'models/purgon.glb',
        function(gltf) {
            console.log('✅ 푸르공 GLB 파일 로드 성공!');
            
            furgonModel = gltf.scene;
            
            // 크기 계산
            const box = new THREE.Box3().setFromObject(furgonModel);
            const size = box.getSize(new THREE.Vector3());
            const center = box.getCenter(new THREE.Vector3());
            
            console.log('📐 원본 크기:', size);
            console.log('📍 원본 중심:', center);
            
            // 중심점 보정
            furgonModel.position.sub(center);
            
            // 크기 조정 (높이 3m 기준)
            const targetHeight = 3;
            const scale = targetHeight / size.y;
            furgonModel.scale.set(scale, scale, scale);
            
            console.log('🔧 적용 스케일:', scale);
            
            // 위치 설정
            furgonModel.position.set(0, 1.5, 0);
            
            // 회전 (정면 보기)
            furgonModel.rotation.y = Math.PI;
            
            // 모든 메쉬에 userData 설정
            furgonModel.traverse((child) => {
                if (child.isMesh) {
                    child.userData = {
                        type: 'furgon',
                        clickable: true,
                        name: '푸르공 UAZ-452'
                    };
                    child.castShadow = true;
                    child.receiveShadow = true;
                }
            });
            
            // 루트에도 userData 설정
            furgonModel.userData = {
                type: 'furgon',
                clickable: true,
                name: '푸르공 UAZ-452'
            };
            
            if (window.scene) {
                window.scene.add(furgonModel);
                console.log('✅ 푸르공 3D 모델 배치 완료!');
                console.log('   위치:', furgonModel.position);
                console.log('   스케일:', furgonModel.scale);
            } else {
                console.error('❌ scene이 없습니다!');
            }
        },
        function(xhr) {
            const percent = (xhr.loaded / xhr.total) * 100;
            console.log('🚐 푸르공 로딩 중: ' + Math.round(percent) + '%');
        },
        function(error) {
            console.error('❌ 푸르공 로드 실패:', error);
            console.log('⚠️ 폴백: 임시 푸르공 박스 생성');
            createFallbackFurgon();
        }
    );
}

// 폴백 박스 생성 함수
function createFallbackFurgon() {
    console.log('📦 폴백 푸르공 박스 생성');
    
    const geometry = new THREE.BoxGeometry(6, 3, 3);
    const material = new THREE.MeshStandardMaterial({
        color: 0x2d5016,
        roughness: 0.8,
        metalness: 0.2,
        emissive: 0x1a3010,
        emissiveIntensity: 0.3
    });
    
    const furgonBody = new THREE.Mesh(geometry, material);
    furgonBody.castShadow = true;
    furgonBody.receiveShadow = true;
    
    furgonBody.userData = {
        type: 'furgon',
        clickable: true,
        name: '푸르공 UAZ-452'
    };
    
    furgonBody.position.set(0, 1.5, 0);
    furgonModel = furgonBody;
    
    if (window.scene) {
        window.scene.add(furgonBody);
        console.log('✅ 폴백 푸르공 배치 완료!');
    }
}

